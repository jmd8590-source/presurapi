# Copia este fichero a .env.local (NUNCA subas .env.local al repositorio).
# Variables públicas (van al navegador, no son secretas):
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT_ID=
NEXT_PUBLIC_APPWRITE_DATABASE_ID=presurapi

# Clave secreta del servidor: SOLO en server actions, NUNCA con el prefijo
# NEXT_PUBLIC_, nunca enviada al cliente. La usan las acciones de login,
# registro, recuperación de contraseña y borrado de cuenta (operaciones que
# necesitan saltarse los permisos por documento de forma controlada).
# Scopes necesarios al crearla en Appwrite: users.read, users.write,
# sessions.write, rows.read, rows.write, tables.read, databases.read.
APPWRITE_API_KEY=

# Resend (Fase 5): envío del presupuesto en PDF por email al cliente.
RESEND_API_KEY=

# URL pública de la app (enlaces en emails y en el PDF del presupuesto).
NEXT_PUBLIC_APP_URL=http://localhost:3000
