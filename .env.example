# Copia este fichero a .env.local (NUNCA subas .env.local al repositorio).
# Variables públicas (van al navegador, no son secretas):
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Clave secreta del servidor: SOLO en server actions / route handlers, NUNCA
# con el prefijo NEXT_PUBLIC_, nunca enviada al cliente. Se usa para resolver
# el enlace público de un presupuesto por su token y otras tareas de servidor
# que deben saltarse RLS de forma controlada.
SUPABASE_SECRET_KEY=

# Resend (Fase 5): envío del presupuesto en PDF por email al cliente.
RESEND_API_KEY=

# URL pública de la app (enlaces en emails y en el PDF del presupuesto).
NEXT_PUBLIC_APP_URL=http://localhost:3000
